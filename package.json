{
   "name": "rsl-plus",
   "displayName": "RSL-plus",
   "description": "RSL / Object RSL language support with diagnostics, navigation and Quick Fixes",
   "author": "Veniamin Rakov + AChumakov",
   "license": "SEE LICENSE IN LICENSE.txt",
   "version": "1.1.7",
   "icon": "icon.png",
   "bugs": {
      "url": "https://github.com/aschumakov/RSL-plus/issues"
   },
   "repository": {
      "type": "git",
      "url": "https://github.com/aschumakov/RSL-plus.git"
   },
   "publisher": "AChumakov",
   "categories": [
      "Programming Languages",
      "Snippets"
   ],
   "pricing": "Free",
   "keywords": [
      "RSL",
      "RStyle",
      "R-Style"
   ],
   "engines": {
      "vscode": "^1.90.0"
   },
   "main": "./client/out/extension",
   "contributes": {
      "languages": [
         {
            "id": "rsl",
            "aliases": [
               "RSL Macro",
               "rsl",
               "RSL"
            ],
            "extensions": [
               ".mac"
            ],
            "configuration": "./language-configuration.json"
         },
         {
            "id": "fchanges",
            "extensions": [
               ".txt"
            ],
            "filenames": [
               "fchanges"
            ],
            "configuration": "./language-configuration.json"
         }
      ],
      "grammars": [
         {
            "language": "fchanges",
            "scopeName": "source.txt",
            "path": "./syntaxes/fchanges.tmLanguage.json"
         },
         {
            "language": "rsl",
            "scopeName": "source.mac",
            "path": "./syntaxes/rsl.tmLanguage.json",
            "balancedBracketScopes": [
               "*"
            ],
            "unbalancedBracketScopes": [
               "comment.block.rsl",
               "comment.line.double-slash.rsl"
            ]
         },
         {
            "scopeName": "OLcomment.injection",
            "path": "./syntaxes/rsl.OLinjection.json",
            "injectTo": [
               "source.mac"
            ]
         },
         {
            "scopeName": "MLcomment.injection",
            "path": "./syntaxes/rsl.MLinjection.json",
            "injectTo": [
               "source.mac"
            ]
         },
         {
            "scopeName": "SQLString.injection",
            "path": "./syntaxes/rsl.SQLinjection.json",
            "injectTo": [
               "source.mac"
            ]
         },
         {
            "scopeName": "SQLSquareBrackets.injection",
            "path": "./syntaxes/rsl.SQL_SB_injection.json",
            "injectTo": [
               "source.mac"
            ]
         }
      ],
      "snippets": [
         {
            "language": "rsl",
            "path": "./snippets/snippets.json"
         }
      ],
      "commands": [
         {
            "command": "extension.insertQueryFromClipboard",
            "title": "Вставить запрос из буфера"
         },
         {
            "command": "extension.copyQueryToClipboard",
            "title": "Копировать запрос в буфер"
         },
         {
            "command": "rsl.foldAllMacros",
            "title": "RSL: Свернуть все Macro в файле"
         },
         {
            "command": "rsl.selectCurrentBlock",
            "title": "RSL: Выделить текущий блок"
         },
         {
            "command": "rsl.smartEnter",
            "title": "RSL: Новая строка с завершением блока"
         }
      ],
      "keybindings": [
         {
            "command": "rsl.smartEnter",
            "key": "enter",
            "when": "editorTextFocus && editorLangId == rsl && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inlineSuggestionVisible && !renameInputVisible && !inSnippetMode"
         }
      ],
      "menus": {
         "editor/context": [
            {
               "when": "resourceLangId == rsl",
               "command": "extension.insertQueryFromClipboard",
               "group": "9_cutcopypaste"
            },
            {
               "when": "resourceLangId == rsl",
               "command": "extension.copyQueryToClipboard",
               "group": "9_cutcopypaste"
            },
            {
               "when": "resourceLangId == rsl",
               "command": "rsl.selectCurrentBlock",
               "group": "1_modification@1"
            },
            {
               "when": "resourceLangId == rsl",
               "command": "rsl.foldAllMacros",
               "group": "1_modification@2"
            }
         ]
      },
      "configuration": {
         "type": "object",
         "title": "RSL Plus",
         "properties": {
            "rslPlus.imports.enabled": {
               "scope": "resource",
               "type": "boolean",
               "default": true,
               "description": "Анализировать символы и ошибки в модулях из Import. Отключение ускоряет работу, но ограничивает навигацию текущим файлом."
            },
            "rslPlus.autoImport.enabled": {
               "scope": "resource",
               "type": "boolean",
               "default": true,
               "description": "Предлагать Auto Import в автодополнении и Quick Fix для неизвестных символов."
            },
            "rslPlus.analysis.workspaceIndexing": {
               "scope": "window",
               "type": "string",
               "enum": [
                  "activeImports",
                  "workspaceIdle",
                  "full"
               ],
               "enumDescriptions": [
                  "Рекомендуется: индексировать только открытые файлы и их цепочки Import.",
                  "Дополнительно индексировать весь проект после паузы в работе.",
                  "Индексировать весь проект сразу; повышает нагрузку на процессор и память."
               ],
               "default": "activeImports",
               "description": "Глубина фонового анализа проекта. На навигацию по Import выбранный режим не влияет."
            },
            "rslPlus.semanticHighlighting.maxFileSizeKb": {
               "scope": "resource",
               "type": "integer",
               "minimum": 0,
               "default": 512,
               "description": "Максимальный размер файла для семантической подсветки, КБ. Для больших файлов остаётся обычная подсветка синтаксиса. 0 — без ограничения."
            },
            "rslPlus.editor.completeBlocksOnEnter": {
               "scope": "resource",
               "type": "boolean",
               "default": true,
               "description": "При Enter после заголовка IF, WHILE, FOR, WITH, MACRO или CLASS создать строку с отступом и добавить закрывающий END."
            },
            "rslPlus.performance.logFile": {
               "scope": "window",
               "type": "string",
               "default": "",
               "description": "Абсолютный путь к JSONL-файлу профилирования. Пустое значение полностью отключает замеры. После изменения перезапустите окно VS Code."
            },
            "rslPlus.diagnostics.enabled": {
               "scope": "resource",
               "type": "boolean",
               "default": true,
               "description": "Показывать найденные проблемы RSL в панели Problems."
            },
            "rslPlus.diagnostics.deprecatedDeclarations": {
               "scope": "resource",
               "type": "boolean",
               "default": true,
               "description": "Показывать устаревшие объявления RECORD и ARRAY."
            },
            "rslPlus.diagnostics.structure": {
               "scope": "resource",
               "type": "boolean",
               "default": true,
               "description": "Проверять скобки, END, ELSE, повторные объявления и Import."
            },
            "rslPlus.diagnostics.unusedVariables": {
               "scope": "resource",
               "type": "boolean",
               "default": true,
               "description": "Предупреждать о неиспользуемых локальных объявлениях."
            },
            "rslPlus.diagnostics.unusedImports": {
               "scope": "resource",
               "type": "boolean",
               "default": true,
               "description": "Предупреждать о неиспользуемых известных модулях."
            },
            "rslPlus.diagnostics.debugBreak": {
               "scope": "resource",
               "type": "boolean",
               "default": true,
               "description": "Предупреждать об оставленном DEBUGBREAK."
            },
            "rslPlus.diagnostics.useBeforeDeclaration": {
               "scope": "resource",
               "type": "boolean",
               "default": true,
               "description": "Проверять использование локальной переменной до объявления."
            },
            "rslPlus.diagnostics.ambiguousReferences": {
               "scope": "resource",
               "type": "boolean",
               "default": true,
               "description": "Проверять неоднозначные ссылки из импортированных модулей."
            },
            "rslPlus.diagnostics.maxProblems": {
               "scope": "resource",
               "type": "integer",
               "minimum": 0,
               "default": 200,
               "description": "Максимальное количество сообщений Problems на открытый файл."
            }
         }
      },
      "configurationDefaults": {
         "[rsl]": {
            "editor.semanticHighlighting.enabled": true
         }
      }
   },
   "activationEvents": [
      "onLanguage:rsl",
      "onCommand:rsl.smartEnter"
   ],
   "scripts": {
      "vscode:prepublish": "npm test",
      "clean": "tsc -b --clean && node -e \"const fs=require('fs'); for (const dir of ['client/out','server/out']) fs.rmSync(dir,{recursive:true,force:true});\"",
      "compile": "npm run clean && tsc -b",
      "watch": "tsc -b -w",
      "test:lexer": "npm run compile && node tests/lexer.test.js",
      "test:formatter": "npm run compile && node tests/formatter.test.js",
      "test:folding": "npm run compile && node tests/folding.test.js",
      "test:definition": "npm run compile && node tests/definition.test.js",
      "test:parser": "npm run compile && node tests/parser-regressions.test.js",
      "test:scope": "npm run compile && node tests/scope-index.test.js",
      "test": "npm run compile && node tests/run-all.js",
      "postinstall": "npm ci --prefix client && npm ci --prefix server",
      "test:diagnostics": "npm run compile && node tests/diagnostics.test.js",
      "test:features": "npm run compile && node tests/language-features.test.js",
      "test:architecture": "npm run compile && node tests/server-services.test.js && node tests/scope-index.test.js && node tests/workspace-resolution.test.js"
   },
   "devDependencies": {
      "@types/node": "22.16.5",
      "typescript": "5.9.3"
   }
}
