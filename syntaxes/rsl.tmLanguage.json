{
   "$schema": "https://raw.githubusercontent.rslom/martinring/tmlanguage/master/tmlanguage.json",
   "name": "RSL",
   "patterns": [
      {
         "include": "#comments"
      },
      {
         "match": "(?i)\\b(macro)\\s+([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)",
         "captures": {
            "1": {
               "name": "storage.type.function.rsl"
            },
            "2": {
               "name": "entity.name.function.rsl"
            }
         }
      },
      {
         "match": "(?i)\\b(class)\\s+([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)",
         "captures": {
            "1": {
               "name": "storage.type.class.rsl"
            },
            "2": {
               "name": "entity.name.type.class.rsl"
            }
         }
      },
      {
         "include": "#rsl_types"
      },
      {
         "include": "#logical_operations"
      },
      {
         "include": "#storage_types"
      },
      {
         "include": "#operators"
      },
      {
         "include": "#numbers"
      },
      {
         "include": "#strings"
      },
      {
         "match": "(?i)\\b(debugbreak|continue|onerror|import|return|break|while|elif|else|with|end|for|if)\\b",
         "name": "keyword.control.rsl"
      },
      {
         "match": "(?i)\\b(v_dbffile|v_decimal|v_doublel|v_integer|v_memaddr|v_numeric|v_txtfile|v_double|v_genobj|v_moneyl|v_string|v_array|v_money|v_struc|v_undef|v_bool|v_date|v_dttm|v_file|v_proc|v_time|v_r2m)\\b",
         "name": "storage.type.rsl"
      },
      {
         "match": "(?i)\\b(class|macro)\\b",
         "name": "entity.name.type.rsl"
      },
      {
         "include": "#std_functions"
      },
      {
         "include": "#modificators"
      },
      {
         "include": "#variables"
      },
      {
         "include": "#global_variables"
      },
      {
         "include": "#constant_global"
      },
      {
         "include": "#function_call"
      },
      {
         "match": "\\b[\\w]+(?=[\\[])(?=[\\s\\w,\"@:]*)",
         "name": "variable.language.array.rsl"
      },
      {
         "include": "#output_string"
      },
      {
         "include": "#var_preamb"
      },
      {
         "include": "#logical_types"
      },
      {
         "match": "(?i)\\b([а-яёa-z_][а-яёa-z0-9_]*)(?=\\s*\\.)",
         "captures": {
            "1": {
               "name": "variable.other.object.rsl"
            }
         }
      }
   ],
   "repository": {
      "logical_operations": {
         "match": "(?i)\\b(and|not|or)\\b",
         "name": "keyword.operator.logical.rsl"
      },
      "rsl_types": {
         "match": "[:]\\s*[@]?\\s*[\\w]{2,}",
         "name": "storage.type.rsl"
      },
      "constant_global": {
         "match": "\\b[_A-ZЙЦУКЕНГШЩЗХФЫВАПРОЛДЖЭЪЯЧСМИТЬБЮ][A-Z_0-9ЙЦУКЕНГШЩЗХФЫВАПРОЛДЖЭЪЯЧСМИТЬБЮ]+\\b",
         "name": "constant.other.rsl"
      },
      "modificators": {
         "match": "(?i)\\b(private|append|dialog|normal|const|local|write|blob|sort|btr|dbf|key|mem|txt)\\b",
         "name": "storage.modifier.rsl"
      },
      "function_call": {
         "match": "\\b[\\w]+\\b\\s*(?=[\\(])(?=[\\s\\w,\"@:]*)",
         "name": "entity.name.function.rsl"
      },
      "std_functions": {
         "name": "storage.modifier.rsl",
         "patterns": [
            {
               "match": "(СТР_УТВЕРДИЛ|СТР_РУКОВОДИТЕЛЬ|СТР_РЕЗКУРАТОР|СТР_ОТКРЫЛ|СТР_КУРАТОР|ОТЧ_УТВЕРДИЛ|ОТЧ_КУРАТОР|ОТЧ_ОТКРЫЛ|ОТЧ_РЕЗКУРАТОР|ОТЧ_РУКОВОДИТЕЛЬ)",
               "name": "entity.name.function.rsl"
            }
         ]
      },
      "output_string": {
         "patterns": [
            {
               "begin": "(?<!\\S)\\[",
               "beginCaptures": {
                  "0": {
                     "name": "string.quoted.single.rsl"
                  }
               },
               "end": "\\]",
               "endCaptures": {
                  "0": {
                     "name": "string.quoted.single.rsl"
                  }
               },
               "name": "string.quoted.single.rsl",
               "patterns": [
                  {
                     "match": "#+",
                     "name": "constant.other.placeholder.output.rsl"
                  }
               ]
            },
            {
               "match": "(\\s|^)\\[(\\s*.*)\\]\\s*(?=;|\\()",
               "name": "string.quoted.single.rsl"
            }
         ]
      },
      "comments": {
         "patterns": [
            {
               "captures": {
                  "1": {
                     "name": "meta.toc-list.banner.block.rsl"
                  }
               },
               "match": "^/\\* =(\\s*.*?)\\s*= \\*/$\\n?",
               "name": "comment.block.rsl"
            },
            {
               "include": "#block_comment"
            },
            {
               "match": "\\*/.*\\n",
               "name": "invalid.illegal.stray-comment-end.rsl"
            },
            {
               "captures": {
                  "1": {
                     "name": "meta.toc-list.banner.line.rsl"
                  }
               },
               "match": "^// =(\\s*.*?)\\s*=\\s*$\\n?",
               "name": "comment.line.banner.rsl"
            },
            {
               "begin": "(^[ \\t]+)?(?=//)",
               "beginCaptures": {
                  "1": {
                     "name": "punctuation.whitespace.comment.leading.rsl"
                  }
               },
               "end": "(?!\\G)",
               "patterns": [
                  {
                     "begin": "//",
                     "beginCaptures": {
                        "0": {
                           "name": "punctuation.definition.comment.rsl"
                        }
                     },
                     "end": "(?=\\n)",
                     "name": "comment.line.double-slash.rsl",
                     "patterns": [
                        {
                           "include": "#line_continuation_character"
                        }
                     ]
                  }
               ]
            }
         ]
      },
      "line_continuation_character": {
         "patterns": [
            {
               "match": "(\\\\)\\n",
               "captures": {
                  "1": {
                     "name": "constant.character.escape.line-continuation.rsl"
                  }
               }
            }
         ]
      },
      "numbers": {
         "patterns": [
            {
               "match": "\\b((0(x|X)[0-9a-fA-F]([0-9a-fA-F']*[0-9a-fA-F])?)|(0(b|B)[01]([01']*[01])?)|(([0-9]([0-9']*[0-9])?\\.?[0-9]*([0-9']*[0-9])?)|(\\.[0-9]([0-9']*[0-9])?))((e|E)(\\+|-)?[0-9]([0-9']*[0-9])?)?)(L|l|UL|ul|u|U|F|f|ll|LL|ull|ULL)?\\b",
               "name": "constant.numeric.rsl"
            }
         ]
      },
      "variables": {
         "patterns": [
            {
               "begin": "(?i)(?:\\b(var)\\b)",
               "beginCaptures": {
                  "0": {
                     "name": "storage.type.rsl"
                  }
               },
               "end": "(?=;)",
               "endCaptures": {
                  "0": {
                     "name": "storage.type.rsl"
                  }
               },
               "patterns": [
                  {
                     "include": "#comments"
                  },
                  {
                     "include": "#function_call"
                  },
                  {
                     "include": "#logical_types"
                  },
                  {
                     "include": "#logical_operations"
                  },
                  {
                     "include": "#operators"
                  },
                  {
                     "include": "#numbers"
                  },
                  {
                     "include": "#strings"
                  },
                  {
                     "include": "#storage_types"
                  },
                  {
                     "include": "#rsl_types"
                  },
                  {
                     "include": "#constant_global"
                  },
                  {
                     "match": "[\\w]{1,}",
                     "name": "variable.parameter.rsl"
                  }
               ]
            }
         ]
      },
      "global_variables": {
         "patterns": [
            {
               "begin": "\\s*(?=\\{)",
               "beginCaptures": {
                  "0": {
                     "name": "storage.type.rsl"
                  }
               },
               "end": "(?=\\})",
               "endCaptures": {
                  "0": {
                     "name": "storage.type.rsl"
                  }
               },
               "patterns": [
                  {
                     "match": "[\\w*]",
                     "name": "variable.parameter.global.rsl"
                  }
               ]
            }
         ]
      },
      "operators": {
         "patterns": [
            {
               "match": "(?<![\\w$])(sizeof)(?![\\w$])",
               "name": "keyword.operator.sizeof.rsl"
            },
            {
               "match": "--",
               "name": "keyword.operator.decrement.rsl"
            },
            {
               "match": "\\+\\+",
               "name": "keyword.operator.increment.rsl"
            },
            {
               "match": "!=|<=|>=|==|<|>",
               "name": "keyword.operator.comparison.rsl"
            },
            {
               "match": "&|\\||\\^|~",
               "name": "keyword.operator.rsl"
            },
            {
               "match": "=",
               "name": "keyword.operator.assignment.rsl"
            },
            {
               "match": "%|\\*|/|-|\\+",
               "name": "keyword.operator.rsl"
            }
         ]
      },
      "strings": {
         "patterns": [
            {
               "begin": "\"",
               "beginCaptures": {
                  "0": {
                     "name": "punctuation.definition.string.begin.rsl"
                  }
               },
               "end": "(?<!\\\\)(?:\\\\\\\\)*\"",
               "endCaptures": {
                  "0": {
                     "name": "punctuation.definition.string.end.rsl"
                  }
               },
               "name": "string.quoted.double.rsl",
               "patterns": [
                  {
                     "include": "#string_escaped_char"
                  },
                  {
                     "include": "#string_placeholder"
                  },
                  {
                     "include": "#line_continuation_character"
                  }
               ]
            },
            {
               "begin": "'",
               "beginCaptures": {
                  "0": {
                     "name": "punctuation.definition.string.begin.rsl"
                  }
               },
               "end": "'",
               "endCaptures": {
                  "0": {
                     "name": "punctuation.definition.string.end.rsl"
                  }
               },
               "name": "string.quoted.single.rsl",
               "patterns": [
                  {
                     "include": "#string_escaped_char"
                  },
                  {
                     "include": "#line_continuation_character"
                  }
               ]
            }
         ]
      },
      "string_escaped_char": {
         "patterns": [
            {
               "match": "(?x)\\\\ (\n\\\\             |\n[abefnprtv'\"?]   |\n[0-3]\\d{,2}     |\n[4-7]\\d?        |\nx[a-fA-F0-9]{,2} |\nu[a-fA-F0-9]{,4} |\nU[a-fA-F0-9]{,8} )",
               "name": "constant.character.escape.rsl"
            },
            {
               "match": "\\\\.",
               "name": "invalid.illegal.unknown-escape.rsl"
            }
         ]
      },
      "string_placeholder": {
         "patterns": [
            {
               "match": "(?x) %\n(\\d+\\$)?                           # field (argument #)\n[#0\\- +']*                          # flags\n[,;:_]?                              # separator character (AltiVec)\n((-?\\d+)|\\*(-?\\d+\\$)?)?          # minimum field width\n(\\.((-?\\d+)|\\*(-?\\d+\\$)?)?)?    # precision\n(hh|h|ll|l|j|t|z|q|L|vh|vl|v|hv|hl)? # length modifier\n[diouxXDOUeEfFgGaACcSspn%]           # conversion type",
               "name": "constant.other.placeholder.rsl"
            },
            {
               "match": "(%)(?!\"\\s*(PRI|SCN))",
               "captures": {
                  "1": {
                     "name": "invalid.illegal.placeholder.rsl"
                  }
               }
            }
         ]
      },
      "storage_types": {
         "patterns": [
            {
               "match": "(?i)\\b(methodref|tbfilelog|datetime|decimal|doublel|integer|memaddr|numeric|procref|specval|variant|double|moneyl|object|record|string|tarray|tbfile|array|const|money|bool|date|file|time|var)\\b",
               "name": "storage.type.rsl"
            }
         ]
      },
      "logical_types": {
         "patterns": [
            {
               "match": "(?i)\\b(false|null|this|true)\\b",
               "name": "constant.language.rsl"
            }
         ]
      },
      "var_preamb": {
         "patterns": [
            {
               "match": "(?i)\\b(var)\\b",
               "name": "storage.type.rsl"
            }
         ]
      },
      "block_comment": {
         "begin": "/\\*",
         "beginCaptures": {
            "0": {
               "name": "punctuation.definition.comment.begin.rsl"
            }
         },
         "end": "\\*/",
         "endCaptures": {
            "0": {
               "name": "punctuation.definition.comment.end.rsl"
            }
         },
         "name": "comment.block.rsl",
         "contentName": "comment.block.rsl",
         "patterns": [
            {
               "include": "#block_comment"
            }
         ]
      }
   },
   "scopeName": "source.mac"
}
