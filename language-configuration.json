{
    "wordPattern": "(?:\\{[^{}\\r\\n]*\\}?)|(?:[A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё0-9_]*)",
    "comments": {
        "lineComment": "//",
        "blockComment": [
            "/*",
            "*/"
        ]
    },
    "brackets": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ]
    ],
    "autoClosingPairs": [
        {
            "open": "{",
            "close": "}"
        },
        {
            "open": "[",
            "close": "]"
        },
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "\"",
            "close": "\"",
            "notIn": [
                "string",
                "comment"
            ]
        },
        {
            "open": "'",
            "close": "'",
            "notIn": [
                "string",
                "comment"
            ]
        }
    ],
    "surroundingPairs": [
        {
            "open": "{",
            "close": "}"
        },
        {
            "open": "[",
            "close": "]"
        },
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "\"",
            "close": "\""
        },
        {
            "open": "'",
            "close": "'"
        }
    ],
    "indentationRules": {
        "increaseIndentPattern": {
            "pattern": "^\\s*(?!.*\\bend\\s*;)(?:(?:(?:private|local)\\s+)?(?:macro|class)\\b|(?:if|while|for|with)\\s*\\(|(?:else|elif|onerror)\\b)",
            "flags": "i"
        },
        "decreaseIndentPattern": {
            "pattern": "^\\s*(?:end\\b|else\\b|elif\\b|onerror\\b)",
            "flags": "i"
        }
    }
}